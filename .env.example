# Скопируйте этот файл в .env.local и заполните. Те же переменные добавьте в Vercel → Settings → Environment Variables.

# Адрес сайта (без / в конце). Пока Vercel-овский, потом https://alemway.kz
NEXT_PUBLIC_SITE_URL=https://alemway.kz

# --- Sanity (админка) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Токен с правами Editor: sanity.io/manage → проект → API → Tokens. ТОЛЬКО на сервере, никому не показывать.
SANITY_API_WRITE_TOKEN=
# Любая длинная случайная строка. Её же вписать в webhook Sanity (поле Secret).
SANITY_REVALIDATE_SECRET=

# --- Telegram (уведомления о заявках) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Яндекс Метрика (необязательно). Пусто = не подключается ---
NEXT_PUBLIC_YM_ID=

# Своя админка /admin: секрет для подписи входа (openssl rand -base64 48)
ADMIN_SESSION_SECRET=
